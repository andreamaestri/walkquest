{
  "name": "walkquest",
  "version": "1.0.0",
  "description": "**Walk in the Quest!** 🚶‍♂️🧭",
  "main": "tailwind.config.js",
  "engines": {
    "node": "22.x"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && vite build",
    "icons": "node scripts/build-icon-subset.mjs",
    "theme": "esbuild scripts/generate-m3-theme.mjs --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/gen-theme.mjs && node node_modules/.cache/gen-theme.mjs",
    "test": "vitest run",
    "heroku-postbuild": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreamaestri/walkquest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andreamaestri/walkquest/issues"
  },
  "homepage": "https://github.com/andreamaestri/walkquest#readme",
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@iconify/vue": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "idb": "^8.0.3",
    "mapbox-gl": "^3.28.1",
    "motion": "^12.43.0",
    "motion-v": "^2.4.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.1"
  },
  "imports": {
    "#walkquest/main": {
      "import": "./walkquest/static/js/main.js",
      "default": "./walkquest/static/js/main.js"
    },
    "#walkquest/*": {
      "import": "./walkquest/static/js/*",
      "default": "./walkquest/static/js/*"
    }
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.7",
    "@material/material-color-utilities": "^0.4.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.41",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "terser": "^5.50.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "resolutions": {
    "vue": "^3.4.0"
  }
}
