# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# Database (PostgreSQL/PostGIS)
DATABASE_URL=postgis://walkquest:walkquest@127.0.0.1:5432/walkquest

# Cache and background jobs
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend map configuration
VITE_MAPBOX_TOKEN=replace-with-a-scoped-mapbox-public-token

# Optional email configuration
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
EMAIL_HOST_PASSWORD=

# Database backend: postgis (default) or oracle (Autonomous Database / Oracle Free)
DJANGO_DB_BACKEND=postgis
# Oracle: the TLS connection string from the OCI console (one-way TLS, no wallet),
# or host:port/service for Oracle Database Free, e.g. localhost:1521/FREEPDB1
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
# Connections per web process (Always Free allows 20 sessions in total)
ORACLE_POOL_MAX=4
# Only for mTLS wallets:
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=
